# Copy this file to .env and fill in your values.

# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///./ecommerce.db

# LLM provider — pick ONE setup below.

# --- Option A: OpenAI ---
LLM_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL left unset for OpenAI's default endpoint

# --- Option B: Groq (fast + free tier, OpenAI-compatible) ---
# LLM_API_KEY=gsk-your-groq-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
